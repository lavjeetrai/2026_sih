# Fine-Tuned SLM Cloud Service (Modal API)
# Used automatically on Vercel deployment or as resilient cloud fallback
MODAL_API_URL=https://railavjeet897--oil-safety-classifier-sifclassifier-analy-8ffce8.modal.run

# AI Engine Selection: 'auto' | 'modal' | 'ollama'
# 'auto': Smart mode (uses local Ollama in dev if running; uses Modal Cloud SLM on Vercel or when Ollama is offline)
# 'modal': Forces cloud fine-tuned SLM on Modal
# 'ollama': Forces local Ollama instance
AI_ENGINE=auto

# Ollama Local Service Configuration (Optional for Vercel; used for local edge inference)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=safety-phi3

# MongoDB Atlas Production Database
MONGODB_URI=mongodb+srv://<username>:<password>@datasih.c4lqpqo.mongodb.net/?appName=datasih
MONGODB_DB=datasih
